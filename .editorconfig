# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.swift]
indent_size = 4

[Makefile]
indent_style = tab

# generated or exported files: leave exactly as produced
[{design/canvas/**,packages/mcp-cards/dist/**,packages/agents/src/generated/**,docs/tasks/JUNIOR_TASKS.md,package-lock.json}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
