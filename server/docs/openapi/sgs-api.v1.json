    "/v1/memories": {
      "get": {
        "operationId": "MemoriesController_list",
        "parameters": [
          {
            "name": "tag",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "min_confidence",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          {
            "name": "visibility",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "personal",
                "project",
                "org"
              ]
            }
          },
          {
            "name": "kind",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "decision",
                "pattern",
                "incident",
                "skill",
                "context",
                "anti-pattern",
                "debug-recipe",
                "environment",
                "note",
                "fact",
                "other"
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "include_archived",
            "required": false,
            "in": "query",
            "schema": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              ],
              "default": false
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "project_id",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "supabase-bearer": []
          }
        ],
        "summary": "List memories for a project",
        "tags": [
          "Memory"
        ]
      },
      "post": {
        "operationId": "MemoriesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "decision",
                      "pattern",
                      "incident",
                      "skill",
                      "context",
                      "anti-pattern",
                      "debug-recipe",
                      "environment",
                      "note",
                      "fact",
                      "other"
                    ],
                    "default": "note"
                  },
                  "project_id": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "personal",
                      "project",
                      "org"
                    ],
                    "default": "project"
                  },
                  "tag_slugs": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
                      "minLength": 2,
                      "maxLength": 40
                    }
                  },
                  "category": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 64
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 1
                  },
                  "importance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.5
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "commit",
                            "pr",
                            "issue",
                            "url",
                            "file",
                            "decision"
                          ]
                        },
                        "ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      },
                      "required": [
                        "kind",
                        "ref"
                      ]
                    }
                  }
                },
                "required": [
                  "content"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "supabase-bearer": []
          }
        ],
        "summary": "Create a memory and enqueue async processing through the outbox",
        "tags": [
          "Memory"
        ]
      }
    },
