NODE_ENV=development
PORT=4100
LOG_LEVEL=info
DATABASE_URL=postgres://openkt:openkt@localhost:15432/openkt
# Legacy alias while old code paths are being removed. Keep it equal to
# DATABASE_URL until every module reads only DATABASE_URL.
DATA_POSTGRES_URL=postgres://openkt:openkt@localhost:15432/openkt
RABBITMQ_URL=amqp://openkt:openkt@localhost:15673
RMQ_PUBLISHER_CONFIRM_TIMEOUT_MS=5000
OPENKT_QUEUE_BACKEND=rabbitmq
# Required when OPENKT_QUEUE_BACKEND=sqs. On EC2, credentials come from
# the instance role through the AWS SDK default credential chain.
AWS_REGION=ap-south-1
OPENKT_SQS_COMMAND_QUEUE_URL=
# Optional; stage-completion events are skipped when this is unset.
OPENKT_SQS_EVENTS_QUEUE_URL=
OPENKT_SQS_WAIT_TIME_SECONDS=20
OPENKT_SQS_VISIBILITY_TIMEOUT_SECONDS=300
OPENKT_SQS_VISIBILITY_HEARTBEAT_SECONDS=60
OPENKT_SQS_SHUTDOWN_GRACE_SECONDS=30
OPENKT_SQS_MAX_MESSAGES=8
OPENKT_SQS_POLL_ERROR_DELAY_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_ACTIVE_POLL_MS=250
OUTBOX_RELAY_IDLE_POLL_MS=5000
OUTBOX_RELAY_CLAIM_TTL_SECONDS=30
OUTBOX_RELAY_RETRY_BASE_MS=1000
OUTBOX_RELAY_RETRY_MAX_MS=60000
RMQ_COMMAND_CONSUMER_PREFETCH=8
OPENKT_EMBEDDING_BACKEND=bge
OPENKT_BGE_URL=http://localhost:8090/embed
OPENKT_BGE_MODEL=BAAI/bge-m3
OPENKT_MEMORY_ENGINE=memmachine
OPENKT_MEMMACHINE_URL=http://localhost:8091
OPENKT_MEMMACHINE_TIMEOUT_MS=20000
OPENKT_MEMMACHINE_POSTGRES_PASSWORD=memmachine_password
OPENKT_OPENAI_EMBED_URL=https://api.openai.com/v1/embeddings
OPENKT_OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_API_KEY=
OPENKT_DEFAULT_LLM_PROVIDER=minimax
OPENKT_DEFAULT_LLM_KEY=
OPENKT_DEFAULT_LLM_BASE_URL=
# Optional model override; unset uses the per-provider default
# (minimax → MiniMax-M2.7). Set to MiniMax-M2.5 to roll back without a
# redeploy.
OPENKT_DEFAULT_LLM_MODEL=MiniMax-M2.5
# Supabase is auth-only. Do not create OpenKT product tables in Supabase;
# product data lives in DATABASE_URL and is managed by Drizzle migrations.
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
OPENKT_INTERNAL_SERVICE_TOKEN=replace-me
OPENKT_MCP_SERVICE_KEY=replace-me
# Comma-separated origins allowed to call /v1/* from a browser with
# credentials. The dashboard issues fetches with `credentials: "include"`,
# so the BFF must echo an exact origin (no wildcards). When unset, the
# default dev allowlist (http://localhost:5273 and the Tailscale dev host
# http://100.74.238.87:5273) is used. Override per environment, e.g.:
#   staging:    https://staging.app.openkt.ai
#   production: https://app.openkt.ai
# Add any new dashboard surfaces here when you start hitting CORS errors.
CORS_ALLOWED_ORIGINS=
