{
  "name": "@openkt/api",
  "version": "0.1.0",
  "private": true,
  "description": "OpenKT NestJS backend — server (HTTP API at api.openkt.ai) + worker (RabbitMQ consumer). Built and deployed independently from web/ (Next.js dashboard).",
  "scripts": {
    "build": "npm run build:api && npm run build:worker",
    "build:api": "nest build server && tsc-alias -p apps/server/tsconfig.app.json",
    "build:worker": "nest build worker && tsc-alias -p apps/worker/tsconfig.app.json",
    "start:api:dev": "nest start server --watch",
    "start:worker:dev": "nest start worker --watch",
    "start:api": "node dist/apps/server/apps/server/src/main.js",
    "start:worker": "node dist/apps/worker/apps/worker/src/main.js",
    "openapi:generate": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"Use npm run test:e2e for jest+supertest, npm run test:unit for jest unit suites, npm run test:smoke for shell checkpoints\"",
    "test:e2e": "jest --config jest-e2e.config.json",
    "test:unit": "jest --config jest-unit.config.json",
    "test:smoke": "bash test/smoke/run-all.sh",
    "test:smoke:optional-auth": "bash test/smoke/optional-user-auth.sh",
    "test:smoke:user-settings": "bash test/smoke/user-settings-roundtrip.sh",
    "test:smoke:memory-read": "bash test/smoke/memory-read.sh",
    "lint": "npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio --port 4983",
    "db:migrate": "ts-node -r tsconfig-paths/register apps/server/src/db/migrate.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1094.0",
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.7",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.0.0",
    "@sentry/node": "^10.57.0",
    "@supabase/supabase-js": "^2.105.1",
    "@types/pg": "^8.20.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^1.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.20.0",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.19",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
