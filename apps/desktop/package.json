{
  "name": "@openkt/desktop",
  "productName": "OpenKT",
  "version": "0.3.0-dev.0",
  "private": true,
  "description": "OpenKT desktop app — Electron shell built from the design canvas.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/masti-ai/openkt-next.git", "directory": "apps/desktop" },
  "author": "OpenKT",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:main && OPENKT_DEV_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && node scripts/bundle-agents.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "dist:mac": "npm run build && node scripts/fetch-llama.mjs && node scripts/dist-mac.mjs",
    "test:main": "vitest run --config test/main/vitest.config.mts",
    "fetch:llama": "node scripts/fetch-llama.mjs",
    "smoke:local-ai": "node scripts/smoke-local-ai.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "playwright-core": "1.59.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
